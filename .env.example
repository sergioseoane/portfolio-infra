# Copia como ".env" (sin ".example") y rellena con tus valores reales.
# Este archivo de ejemplo SI se sube a GitHub; el ".env" real, nunca.

# Token del tunel de Cloudflare (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# Credenciales del panel web de Nagios - NO dejar las de fabrica de
# la imagen (nagiosadmin/nagios). Usa una contrasena fuerte.
NAGIOS_ADMIN_USER=admin
NAGIOS_ADMIN_PASSWORD=

# Contrasena del superusuario "postgres" de la base de datos.
POSTGRES_ROOT_PASSWORD=

# Contrasenas de los roles de menor privilegio (ver
# postgres-retail-admin/schema/03_roles_permisos.sh). Usa
# contrasenas distintas para cada una, largas y aleatorias.
RETAIL_READONLY_PASSWORD=
RETAIL_APP_PASSWORD=
